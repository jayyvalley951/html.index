<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>JAYY VALLEY — 5LEAF SYNDICATE</title>

<style>

/* =========================================================

   JAYY VALLEY — 5LEAF SYNDICATE

   FOUNDATION V2

   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Inter:wght@400;500;600;700;800&display=swap');

:root {

    --black: #030303;

    --dark: #080809;

    --panel: #101014;

    --panel2: #15151a;

    --white: #f4f1e9;

    --muted: #9b9893;

    --gold: #c7a96b;

    --gold-light: #f0d99a;

    --purple: #684494;

    --red: #751d25;

    --line: rgba(199,169,107,.22);

}

* {

    box-sizing: border-box;

    margin: 0;

    padding: 0;

}

html {

    scroll-behavior: smooth;

}

body {

    background:

        radial-gradient(

            circle at 50% 0%,

            rgba(104,68,148,.20),

            transparent 34rem

        ),

        radial-gradient(

            circle at 90% 45%,

            rgba(117,29,37,.10),

            transparent 30rem

        ),

        var(--black);

    color: var(--white);

    font-family: Inter, Arial, sans-serif;

    line-height: 1.6;

    overflow-x: hidden;

}

body::before {

    content: "";

    position: fixed;

    inset: 0;

    pointer-events: none;

    opacity: .08;

    background-image:

        linear-gradient(

            rgba(255,255,255,.04) 1px,

            transparent 1px

        ),

        linear-gradient(

            90deg,

            rgba(255,255,255,.04) 1px,

            transparent 1px

        );

    background-size: 50px 50px;

    mask-image:

        linear-gradient(

            to bottom,

            black,

            transparent 85%

        );

    z-index: 0;

}

a {

    color: inherit;

    text-decoration: none;

}

button,

input {

    font-family: inherit;

}

.container {

    width: min(1150px, 92%);

    margin: auto;

}

/* =========================================================

   NAVIGATION

   ========================================================= */

nav {

    position: fixed;

    top: 0;

    left: 0;

    right: 0;

    z-index: 100;

    background: rgba(3,3,3,.78);

    backdrop-filter: blur(18px);

    border-bottom:

        1px solid rgba(199,169,107,.18);

}

.nav-inner {

    min-height: 72px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

}

.brand {

    font-family: Cinzel, serif;

    font-weight: 900;

    font-size: .9rem;

    letter-spacing: .16em;

}

.brand span {

    color: var(--gold);

}

.nav-links {

    display: flex;

    gap: 20px;

    flex-wrap: wrap;

    justify-content: flex-end;

}

.nav-links a {

    color: #aaa;

    font-size: .68rem;

    letter-spacing: .15em;

    text-transform: uppercase;

    transition: .25s ease;

}

.nav-links a:hover {

    color: var(--gold);

}

/* =========================================================

   HERO

   ========================================================= */

.hero {

    min-height: 100vh;

    position: relative;

    display: grid;

    place-items: center;

    text-align: center;

    padding:

        130px 0

        90px;

    overflow: hidden;

}

.hero-content {

    position: relative;

    z-index: 5;

}

.eyebrow {

    color: var(--gold);

    font-size: .68rem;

    letter-spacing: .38em;

    text-transform: uppercase;

    margin-bottom: 18px;

}

.hero h1 {

    font-family: Cinzel, serif;

    font-size:

        clamp(3.7rem, 13vw, 9rem);

    line-height: .86;

    letter-spacing: .04em;

    text-shadow:

        0 0 35px rgba(199,169,107,.12);

}

.hero h1 span {

    color: var(--gold);

}

/* =========================================================

   ORIGINAL 5-LEAF EMBLEM

   ========================================================= */

.clover-area {

    width: 250px;

    height: 250px;

    margin:

        40px auto

        35px;

    position: relative;

    display: grid;

    place-items: center;

}

.clover-energy {

    position: absolute;

    width: 240px;

    height: 240px;

    border-radius: 50%;

    border:

        1px solid rgba(199,169,107,.18);

    box-shadow:

        0 0 50px rgba(104,68,148,.15),

        inset 0 0 40px rgba(199,169,107,.05);

    animation:

        pulse 4s ease-in-out infinite;

}

.clover-energy::before {

    content: "";

    position: absolute;

    inset: 20px;

    border:

        1px dashed rgba(199,169,107,.20);

    border-radius: 50%;

    animation:

        reverseSpin 18s linear infinite;

}

/*

   This is an original five-leaf symbol.

   It is intentionally not a copy of any existing logo.

*/

.five-leaf {

    position: relative;

    width: 180px;

    height: 180px;

    animation:

        spinLeaf 18s linear infinite;

    transition:

        animation-duration .5s ease;

    filter:

        drop-shadow(0 0 12px rgba(199,169,107,.18));

}

.clover-area:hover .five-leaf {

    animation-duration: 4s;

}

/* Individual leaves */

.leaf {

    position: absolute;

    width: 68px;

    height: 82px;

    background:

        linear-gradient(

            145deg,

            #e4ce92,

            #9e8149 55%,

            #4f3a1d

        );

    border:

        1px solid rgba(255,238,181,.55);

    box-shadow:

        inset 0 0 15px rgba(255,255,255,.10),

        0 0 15px rgba(199,169,107,.12);

    border-radius:

        65% 35% 65% 35%;

    left: 56px;

    top: 49px;

    transform-origin: 50% 100%;

}

/* top */

.leaf.one {

    transform:

        rotate(0deg)

        translateY(-52px);

}

/* upper-right */

.leaf.two {

    transform:

        rotate(72deg)

        translateY(-52px);

}

/* lower-right */

.leaf.three {

    transform:

        rotate(144deg)

        translateY(-52px);

}

/* lower-left */

.leaf.four {

    transform:

        rotate(216deg)

        translateY(-52px);

}

/* upper-left */

.leaf.five {

    transform:

        rotate(288deg)

        translateY(-52px);

}

/* Leaf vein */

.leaf::after {

    content: "";

    position: absolute;

    width: 1px;

    height: 58px;

    background:

        linear-gradient(

            transparent,

            rgba(255,244,201,.65),

            transparent

        );

    left: 50%;

    top: 12px;

    transform:

        translateX(-50%)

        rotate(-10deg);

}

/* Center */

.clover-center {

    position: absolute;

    width: 65px;

    height: 65px;

    border-radius: 50%;

    display: grid;

    place-items: center;

    z-index: 10;

    background:

        radial-gradient(

            circle,

            #17120a,

            #080706 70%

        );

    border:

        2px solid var(--gold-light);

    box-shadow:

        0 0 25px rgba(199,169,107,.35),

        inset 0 0 20px rgba(199,169,107,.12);

}

.clover-center span {

    font-family: Cinzel, serif;

    font-size: 2rem;

    font-weight: 900;

    color: var(--gold-light);

    text-shadow:

        0 0 12px rgba(199,169,107,.55);

}

/* =========================================================

   MAGIC PARTICLES

   ========================================================= */

.magic {

    position: absolute;

    width: 4px;

    height: 4px;

    background: var(--gold);

    border-radius: 50%;

    opacity: .7;

    box-shadow:

        0 0 10px var(--gold);

    animation:

        floatParticle 5s ease-in-out infinite;

}

.magic.one {

    left: 20%;

    top: 35%;

}

.magic.two {

    left: 75%;

    top: 30%;

    animation-delay: 1s;

}

.magic.three {

    left: 15%;

    top: 65%;

    animation-delay: 2s;

}

.magic.four {

    left: 82%;

    top: 67%;

    animation-delay: 3s;

}

.magic.five {

    left: 50%;

    top: 18%;

    animation-delay: 1.5s;

}

/* =========================================================

   HERO TEXT

   ========================================================= */

.hero h2 {

    font-family: Cinzel, serif;

    font-size:

        clamp(1rem, 3vw, 1.7rem);

    letter-spacing: .22em;

    margin-bottom: 12px;

}

.hero h2 span {

    color: var(--gold);

}

.hero p {

    max-width: 680px;

    margin: auto;

    color: var(--muted);

    font-size: .98rem;

}

.cta-row {

    margin-top: 30px;

    display: flex;

    justify-content: center;

    gap: 12px;

    flex-wrap: wrap;

}

.btn {

    display: inline-block;

    padding:

        13px 22px;

    border:

        1px solid var(--gold);

    font-size: .7rem;

    font-weight: 800;

    letter-spacing: .12em;

    text-transform: uppercase;

    transition: .25s ease;

}

.btn.primary {

    background: var(--gold);

    color: #050505;

}

.btn.secondary {

    border-color: #555;

    color: #ddd;

}

.btn:hover {

    transform: translateY(-3px);

    box-shadow:

        0 8px 25px rgba(0,0,0,.3);

}

/* =========================================================

   SECTIONS

   ========================================================= */

section {

    padding:

        100px 0;

}

.section-head {

    max-width: 760px;

    margin-bottom: 40px;

}

.kicker {

    color: var(--gold);

    font-size: .68rem;

    letter-spacing: .3em;

    text-transform: uppercase;

    margin-bottom: 10px;

}

.section-head h2 {

    font-family: Cinzel, serif;

    font-size:

        clamp(2rem, 5vw, 3.6rem);

    line-height: 1.05;

}

.section-head p {

    color: var(--muted);

    margin-top: 15px;

}

/* =========================================================

   PANELS

   ========================================================= */

.panel {

    position: relative;

    overflow: hidden;

    border:

        1px solid var(--line);

    background:

        linear-gradient(

            145deg,

            rgba(255,255,255,.035),

            rgba(255,255,255,.008)

        );

    padding: 30px;

    transition:

        transform .3s ease,

        border-color .3s ease;

}

.panel:hover {

    transform: translateY(-4px);

    border-color:

        rgba(199,169,107,.4);

}

.panel::after {

    content: "";

    position: absolute;

    width: 130px;

    height: 130px;

    right: -65px;

    top: -65px;

    border:

        1px solid rgba(199,169,107,.14);

    border-radius: 50%;

}

.grid {

    display: grid;

    gap: 18px;

}

.grid-2 {

    grid-template-columns:

        repeat(2, minmax(0,1fr));

}

.grid-3 {

    grid-template-columns:

        repeat(3, minmax(0,1fr));

}

.grid-5 {

    grid-template-columns:

        repeat(5, minmax(0,1fr));

}

/* =========================================================

   FIVE SYNS

   ========================================================= */

.syn {

    min-height: 200px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

}

.syn .number {

    font-family: Cinzel, serif;

    color: var(--gold);

    font-size: 1.8rem;

}

.syn h3 {

    font-family: Cinzel, serif;

    letter-spacing: .1em;

    margin-bottom: 5px;

}

.syn p {

    color: var(--muted);

    font-size: .88rem;

}

/* =========================================================

   ABOUT

   ========================================================= */

.about-copy {

    max-width: 820px;

    color: #d0ccc5;

    font-size: 1.08rem;

}

/* =========================================================

   MUSIC

   ========================================================= */

.music-card {

    min-height: 245px;

}

.music-card h3,

.coming h3 {

    font-family: Cinzel, serif;

    font-size: 1.35rem;

    letter-spacing: .1em;

    margin-bottom: 8px;

}

.tag {

    display: inline-block;

    color: var(--gold);

    border:

        1px solid rgba(199,169,107,.35);

    padding:

        5px 9px;

    font-size: .62rem;

    letter-spacing: .15em;

    text-transform: uppercase;

    margin-bottom: 20px;

}

/* =========================================================

   COMING SOON

   ========================================================= */

.coming {

    min-height: 260px;

    display: flex;

    flex-direction: column;

    justify-content: center;

}

.coming strong {

    color: var(--gold);

    font-size: .68rem;

    letter-spacing: .2em;

    text-transform: uppercase;

    margin-bottom: 8px;

}

.muted {

    color: var(--muted);

}

/* =========================================================

   JOIN

   ========================================================= */

.join {

    text-align: center;

    padding:

        75px 25px;

    border:

        1px solid rgba(199,169,107,.3);

    background:

        radial-gradient(

            circle at 50% 0%,

            rgba(104,68,148,.18),

            transparent 60%

        ),

        #09090b;

}

.join p {

    max-width: 650px;

    margin:

        15px auto;

    color: var(--muted);

}

.form {

    max-width: 560px;

    margin:

        28px auto 0;

    display: flex;

    gap: 8px;

}

.form input {

    flex: 1;

    min-width: 0;

    background: #050505;

    border:

        1px solid #444;

    color: white;

    padding:

        14px 15px;

    outline: none;

}

.form input:focus {

    border-color: var(--gold);

}

.form button {

    border:

        1px solid var(--gold);

    background:

        var(--gold);

    color: #050505;

    padding:

        0 22px;

    font-weight: 800;

    cursor: pointer;

}

.form-message {

    margin-top: 14px;

    color: var(--gold);

    font-size: .82rem;

    min-height: 1.4em;

}

/* =========================================================

   FOOTER

   ========================================================= */

footer {

    border-top:

        1px solid var(--line);

    padding:

        35px 0;

    color: #777;

    font-size: .72rem;

}

.footer-inner {

    display: flex;

    justify-content: space-between;

    gap: 20px;

    flex-wrap: wrap;

}

footer strong {

    color: #aaa;

}

/* =========================================================

   ANIMATIONS

   ========================================================= */

@keyframes spinLeaf {

    from {

        transform: rotate(0deg);

    }

    to {

        transform: rotate(360deg);

    }

}

@keyframes reverseSpin {

    from {

        transform: rotate(360deg);

    }

    to {

        transform: rotate(0deg);

    }

}

@keyframes pulse {

    0%,

    100% {

        transform: scale(1);

        opacity: .7;

    }

    50% {

        transform: scale(1.05);

        opacity: 1;

    }

}

@keyframes floatParticle {

    0% {

        transform:

            translateY(0)

            scale(1);

        opacity: .2;

    }

    50% {

        transform:

            translateY(-35px)

            scale(1.5);

        opacity: .9;

    }

    100% {

        transform:

            translateY(0)

            scale(1);

        opacity: .2;

    }

}

/* =========================================================

   MOBILE

   ========================================================= */

@media (max-width: 800px) {

    .nav-inner {

        padding:

            14px 0;

        align-items:

            flex-start;

    }

    .nav-links {

        gap: 10px;

    }

    .grid-2,

    .grid-3,

    .grid-5 {

        grid-template-columns: 1fr;

    }

    section {

        padding:

            75px 0;

    }

    .clover-area {

        transform: scale(.88);

    }

    .form {

        flex-direction: column;

    }

    .form button {

        padding:

            14px;

    }

    .hero {

        padding-top:

            145px;

    }

}

</style>

</head>

<body>

<!-- ======================================================

     NAV

     ====================================================== -->

<nav>

    <div class="container nav-inner">

        <a class="brand" href="#top">

            JAYY <span>VALLEY</span>

        </a>

        <div class="nav-links">

            <a href="#syndicate">

                Syndicate

            </a>

            <a href="#music">

                Music

            </a>

            <a href="#books">

                Books

            </a>

            <a href="#media">

                Media

            </a>

            <a href="#fiveleaf">

                5LEAF

            </a>

            <a href="#join">

                Join

            </a>

        </div>

    </div>

</nav>

<!-- ======================================================

     HERO

     ====================================================== -->

<main id="top">

<section class="hero">

    <!-- Magical particles -->

    <div class="magic one"></div>

    <div class="magic two"></div>

    <div class="magic three"></div>

    <div class="magic four"></div>

    <div class="magic five"></div>

    <div class="hero-content container">

        <div class="eyebrow">

            JAYY VALLEY — THE ARCHIVE OPENS

        </div>

        <h1>

            JAYY

            <br>

            <span>VALLEY</span>

        </h1>

        <!-- =================================================

             FIVE LEAF SYMBOL

             ================================================= -->

        <div class="clover-area">

            <div class="clover-energy"></div>

            <div class="five-leaf">

                <div class="leaf one"></div>

                <div class="leaf two"></div>

                <div class="leaf three"></div>

                <div class="leaf four"></div>

                <div class="leaf five"></div>

            </div>

            <div class="clover-center">

                <span>5</span>

            </div>

        </div>

        <h2>

            WELCOME TO THE

            <span>5LEAF SYNDICATE</span>

        </h2>

        <p>

            A creative world built around music,

            stories, visuals, ideas and the people

            who choose to grow with it.

        </p>

        <div class="cta-row">

            <a

                class="btn primary"

                href="#syndicate"

            >

                Enter The Syndicate

            </a>

            <a

                class="btn secondary"

                href="#music"

            >

                Explore The Music

            </a>

        </div>

    </div>

</section>

<!-- ======================================================

     SYNDICATE

     ====================================================== -->

<section id="syndicate">

    <div class="container">

        <div class="section-head">

            <div class="kicker">

                01 / The Syndicate

            </div>

            <h2>

                WELCOME TO THE SYNDICATE.

            </h2>

            <p>

                The 5LEAF Syndicate is the community

                around Jayy Valley — supporters,

                listeners, readers and creators connected

                by the same hunger to create, remember,

                evolve and believe.

            </p>

        </div>

        <div class="grid grid-5">

            <article class="panel syn">

                <div class="number">

                    I

                </div>

                <div>

                    <h3>

                        CREATE

                    </h3>

                    <p>

                        Make something from the ideas

                        living in your head.

                    </p>

                </div>

            </article>

            <article class="panel syn">

                <div class="number">

                    II

                </div>

                <div>

                    <h3>

                        REMEMBER

                    </h3>

                    <p>

                        Keep the past without letting

                        it control the future.

                    </p>

                </div>

            </article>

            <article class="panel syn">

                <div class="number">

                    III

                </div>

                <div>

                    <h3>

                        EVOLVE

                    </h3>

                    <p>

                        Growth is part of the story.

                        Never stay still.

                    </p>

                </div>

            </article>

            <article class="panel syn">

                <div class="number">

                    IV

                </div>

                <div>

                    <h3>

                        PROTECT

                    </h3>

                    <p>

                        Protect your people,

                        your vision and your purpose.

                    </p>

                </div>

            </article>

            <article class="panel syn">

                <div class="number">

                    V

                </div>

                <div>

                    <h3>

                        BELIEVE

                    </h3>

                    <p>

                        Move before the world

                        gives you permission.

                    </p>

                </div>

            </article>

        </div>

    </div>

</section>

<!-- ======================================================

     ABOUT

     ====================================================== -->

<section id="about">

    <div class="container">

        <div class="section-head">

            <div class="kicker">

                02 / Get To Know Me

            </div>

            <h2>

                THE PERSON BEHIND THE WORLD.

            </h2>

        </div>

        <div class="panel">

            <p class="about-copy">

                I'm Jayy Valley.

                Music, writing, visuals and ideas

                are different doors into the same world.

                This site is the beginning of that world

                becoming something people can actually

                step inside.

            </p>

            <div

                class="cta-row"

                style="justify-content:flex-start"

            >

                <a

                    class="btn secondary"

                    href="#join"

                >

                    Stay Connected

                </a>

            </div>

        </div>

    </div>

</section>

<!-- ======================================================

     MUSIC

     ====================================================== -->

<section id="music">

    <div class="container">

        <div class="section-head">

            <div class="kicker">

                03 / Music

            </div>

            <h2>

                THE SOUND OF THE VALLEY.

            </h2>

            <p>

                Music is one of the main pillars

                of Jayy Valley.

            </p>

        </div>

        <div class="grid grid-2">

            <article class="panel music-card">

                <span class="tag">

                    Coming Soon

                </span>

                <h3>

                    RELEASES

                </h3>

                <p class="muted">

                    Official music, projects

                    and singles will be added here.

                </p>

            </article>

            <article class="panel music-card">

                <span class="tag">

                    Syndicate Exclusive

                </span>

                <h3>

                    UNRELEASED

                </h3>

                <p class="muted">

                    A future vault for songs,

                    demos, snippets and material

                    reserved for the Syndicate.

                </p>

            </article>

        </div>

    </div>

</section>

<!-- ======================================================

     BOOKS

     ====================================================== -->

<section id="books">

    <div class="container">

        <div class="section-head">

            <div class="kicker">

                04 / Books

            </div>

            <h2>

                STORIES FROM THE ARCHIVE.

            </h2>

            <p>

                Writing, books and personal stories

                will become another part of the

                Jayy Valley universe.

            </p>

        </div>

        <div class="panel coming">

            <strong>

                Coming Soon

            </strong>

            <h3>

                MEMORIES I TRIED TO FORGET

            </h3>

            <p class="muted">

                Book information, excerpts,

                updates and release details

                will live here.

            </p>

        </div>

    </div>

</section>

<!-- ======================================================

     MEDIA

     ====================================================== -->

<section id="media">

    <div class="container">

        <div class="section-head">

            <div class="kicker">

                05 / Media

            </div>

            <h2>

                THE VISUAL ARCHIVE.

            </h2>

            <p>

                Videos, photography, artwork,

                behind-the-scenes material,

                shows and future visual projects.

            </p>

        </div>

        <div class="grid grid-3">

            <div class="panel coming">

                <strong>

                    Coming Soon

                </strong>

                <h3>

                    VIDEO

                </h3>

                <p class="muted">

                    Visuals and video projects.

                </p>

            </div>

            <div class="panel coming">

                <strong>

                    Coming Soon

                </strong>

                <h3>

                    ARTWORK

                </h3>

                <p class="muted">

                    Original art and visual experiments.

                </p>

            </div>

            <div class="panel coming">

                <strong>

                    Coming Soon

                </strong>

                <h3>

                    EVENTS

                </h3>

                <p class="muted">

                    Shows, pop-ups and appearances.

                </p>

            </div>

        </div>

    </div>

</section>

<!-- ======================================================

     5LEAF

     ====================================================== -->

<section id="fiveleaf">

    <div class="container">

        <div class="section-head">

            <div class="kicker">

                06 / 5LEAF

            </div>

            <h2>

                THE APPAREL ARCHIVE.

            </h2>

            <p>

                5LEAF is the clothing and merchandise

                side of the world.

            </p>

        </div>

        <div class="panel coming">

            <strong>

                Coming Soon

            </strong>

            <h3>

                5LEAF APPAREL

            </h3>

            <p class="muted">

                Future apparel, accessories

                and limited drops will be

                announced here first.

            </p>

        </div>

    </div>

</section>

<!-- ======================================================

     JOIN

     ====================================================== -->

<section id="join">

    <div class="container">

        <div class="join">

            <div class="kicker">

                07 / Join The Syndicate

            </div>

            <h2>

                ARE YOU READY?

            </h2>

            <p>

                Join the list for unreleased music,

                exclusive offers, merch drops,

                books, shows, pop-ups,

                announcements and updates

                from Jayy Valley.

            </p>

            <form

                class="form"

                id="joinForm"

            >

                <input

                    id="email"

                    type="email"

                    placeholder="your@email.com"

                    required

                >

                <button type="submit">

                    JOIN

                </button>

            </form>

            <div

                class="form-message"

                id="formMessage"

            ></div>

            <small class="muted">

                Newsletter connection will be

                activated when we connect a real

                email service.

            </small>

        </div>

    </div>

</section>

</main>

<!-- ======================================================

     FOOTER

     ====================================================== -->

<footer>

    <div class="container footer-inner">

        <div>

            © <span id="year"></span>

            <strong>JAYY VALLEY</strong>

        </div>

        <div>

            WELCOME TO THE SYNDICATE.

        </div>

    </div>

</footer>

<!-- ======================================================

     JAVASCRIPT

     ====================================================== -->

<script>

document.getElementById("year").textContent =

    new Date().getFullYear();

document

    .getElementById("joinForm")

    .addEventListener(

        "submit",

        function(event) {

            event.preventDefault();

            const email =

                document

                .getElementById("email")

                .value

                .trim();

            const message =

                document

                .getElementById("formMessage");

            if (!email) {

                message.textContent =

                    "Enter your email to join.";

                return;

            }

            message.textContent =

                "You're on the list — welcome to the Syndicate.";

            this.reset();

        }

    );

</script>

</body>

</html>
